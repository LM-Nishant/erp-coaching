{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "tsx src/infrastructure/database/cli.ts create",
    "db:migrate": "tsx src/infrastructure/database/cli.ts migrate",
    "db:migrate:undo": "tsx src/infrastructure/database/cli.ts migrate:undo",
    "db:migrate:status": "tsx src/infrastructure/database/cli.ts migrate:status",
    "db:seed": "tsx src/infrastructure/database/cli.ts seed",
    "db:seed:undo": "tsx src/infrastructure/database/cli.ts seed:undo",
    "db:reset": "tsx src/infrastructure/database/cli.ts reset",
    "secrets:reencrypt": "tsx src/infrastructure/database/cli.ts secrets:reencrypt",
    "students:backfill-accounts": "tsx src/infrastructure/database/cli.ts students:backfill-accounts",
    "make:migration": "tsx src/infrastructure/database/cli.ts make:migration",
    "make:module": "tsx scripts/make-module.ts"
  },
  "dependencies": {
    "@erp/shared": "0.1.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.6.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.4",
    "umzug": "^3.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "vitest": "^5.1.1"
  }
}
