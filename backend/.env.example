# Copy to backend/.env and adjust. Never commit real secrets. Blank values (KEY=) use the default.
# Production runs from deploy/.env instead (docs/deployment.md).
NODE_ENV=development
PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Public origin of the web app (links into the app: website buttons, course checkout). Required in
# production; blank = the first http(s) CORS_ORIGINS entry.
PUBLIC_WEB_URL=http://localhost:5173
# Web dev server, Ionic serve and Capacitor native webviews
CORS_ORIGINS=http://localhost:5173,http://localhost:8100,capacitor://localhost,http://localhost,https://localhost
LOG_LEVEL=debug
# Express "trust proxy" hops: 0 when clients connect directly, 1 behind one reverse proxy (nginx)
TRUST_PROXY=0
# Reported by /api/ready and attached to tracked errors (git SHA or image tag)
APP_VERSION=dev

# --- Error tracking: none | log (structured "error_tracking" log entries) | webhook (POST JSON events) ---
ERROR_TRACKING_PROVIDER=none
# Required for webhook: your collector or a vendor's ingest proxy
ERROR_TRACKING_WEBHOOK_URL=

# --- MySQL 8 (local install) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_coaching
DB_USER=erp_dev
DB_PASSWORD=change-me
DB_LOGGING=false
# Used by `npm test` (database is dropped & recreated on every run!)
# Test file order is set in the shell, not here: TEST_FILE_ORDER=reverse|shuffle [TEST_FILE_SEED=<n>] npm test
TEST_DB_NAME=erp_coaching_test

# --- Secrets (dev defaults exist; REQUIRED in production, at least 16 characters) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   (must be 32 bytes, base64)
ENCRYPTION_KEY=
# Signs short-lived file/media URLs: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_URL_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
IMPERSONATION_TTL_SECONDS=1800

# --- OTP & devices ---
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
MAX_ACTIVE_DEVICES=2
# Inactivity logout (minutes, 0 = off) when the institute has no `security.idle_timeout_minutes` setting
SESSION_IDLE_TIMEOUT_MINUTES=0

# --- File storage ---
STORAGE_DRIVER=local
# Relative to backend/
STORAGE_LOCAL_ROOT=./storage
MAX_UPLOAD_MB=100
SIGNED_URL_TTL_SECONDS=300
# ffmpeg binary for LMS video -> HLS transcoding (default: ffmpeg on PATH); without it videos are served as MP4
FFMPEG_PATH=

# --- AI defaults (overridden by Super Admin > AI configuration) ---
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=60000
# Development/test only: while no API key is configured, AI features use the deterministic
# built-in mock provider (keyword grading, simulated OCR, sample questions). Never used in production.
AI_MOCK_FALLBACK=true

# --- Integration adapters (only console/mock implementations exist today) ---
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console
PAYMENT_GATEWAY=mock
STREAMING_PROVIDER=mock
BIOMETRIC_PROVIDER=mock

# --- Live classes: LiveKit (STREAMING_PROVIDER=livekit, docs/integrations/live-streaming.md) ---
# Clients connect to LIVEKIT_URL (wss://…); the API calls LIVEKIT_API_URL, which defaults to LIVEKIT_URL.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=erp
# local: Egress writes MP4s into LIVEKIT_EGRESS_OUTPUT_DIR (its own path), the same directory the API reads as
# LIVEKIT_RECORDINGS_DIR. s3: Egress uploads to the staging bucket below (LiveKit Cloud).
LIVEKIT_RECORDING_OUTPUT=local
LIVEKIT_EGRESS_OUTPUT_DIR=/out
LIVEKIT_RECORDINGS_DIR=./tmp/livekit-recordings
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_REGION=us-east-1
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET_KEY=
LIVEKIT_S3_FORCE_PATH_STYLE=false

# --- ZKTeco/eSSL biometric devices: ADMS push on /iclock/* (docs/integrations/biometric.md) ---
# Requests per minute per client IP (pushes and command polls; several devices behind one NAT share it)
RATE_LIMIT_ADMS_PER_MIN=600
# Largest upload in KB (at most 8192) and most records in one, both checked before parsing
ADMS_MAX_BODY_KB=2048
ADMS_MAX_RECORDS=10000
# Punches older than this many days are acknowledged but not recorded (first sync, wrong device clock)
ADMS_BACKFILL_DAYS=31

# --- Google Calendar for appointments (docs/integrations/google-calendar.md): mock | google ---
# google needs the platform's Google OAuth client (Web application) and refuses to start without it.
CALENDAR_PROVIDER=mock
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Blank = <API_PUBLIC_URL>/api/calendar/public/google/callback; register it in Google Cloud
GOOGLE_OAUTH_REDIRECT_URI=

# --- Background jobs ---
JOBS_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_MS=2000
# Minutes between checks of open payment gateway orders and refunds (docs/integrations/payments.md)
PAYMENT_RECONCILE_INTERVAL_MINUTES=10

# --- Rate limits per client IP (CONTRIBUTING.md, "Rate limiters"); false disables all of them ---
RATE_LIMIT_ENABLED=true
# Per minute: every /api request except media; signed files and HLS segments
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_MEDIA_PER_MIN=3000
# Per 15 minutes: password login and OTP request/verify; token refresh and logout; public form submissions
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_TOKEN_MAX=600
RATE_LIMIT_PUBLIC_FORM_MAX=60
# Per minute: biometric device pushes; payment gateway webhooks
RATE_LIMIT_DEVICE_PER_MIN=120
RATE_LIMIT_WEBHOOK_PER_MIN=300

# --- Seed data (development defaults; production seeding refuses the default super admin password) ---
SEED_SUPERADMIN_MOBILE=9000000000
SEED_SUPERADMIN_PASSWORD=Admin@12345
# Demo institutes and users (README): default true, false in production
SEED_DEMO_DATA=
SEED_DEMO_PASSWORD=Password@123

# --- Development only (refused in production) ---
# Also append every console-provider message (OTPs, notifications) to this JSONL file, relative to backend/
DEV_OUTBOX_FILE=
