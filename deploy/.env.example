# Production settings for deploy/docker-compose.yml. Copy to deploy/.env (chmod 600), fill in, and keep it
# out of version control (deploy/.gitignore) - store the real values in your secret manager/password vault.
# This file is read twice: by Compose for ${VARIABLE} substitution and as the api/migrate env_file.
#
# Rules: one KEY=value per line, no inline comments. Compose expands "$" in values: single-quote any
# value containing "$" (e.g. DB_PASSWORD='pa$$word'). Blank values mean "use the default".
#
# The MySQL root password is NOT in this file: put it alone in deploy/secrets/mysql_root_password
#   mkdir -p secrets && openssl rand -hex 32 > secrets/mysql_root_password && chmod 600 secrets/mysql_root_password

# ------------------------------------------------------------------ images
# Registry prefix with trailing slash (e.g. ghcr.io/acme/); empty = images built locally.
ERP_REGISTRY=
# Release tag of erp-api/erp-web (e.g. v1.4.0 or a git SHA); also reported as the version by /api/ready.
# Roll back by setting the previous tag and running `docker compose up -d`.
ERP_IMAGE_TAG=latest

# ------------------------------------------------------------------ public endpoint
# Host name of the app + API, and its public origin (no trailing slash). The web image is built for
# exactly this origin (VITE_API_URL), so changing it requires rebuilding the web image.
SERVER_NAME=app.example.com
PUBLIC_URL=https://app.example.com
# Public origin of the web app used in links the API builds (website buttons, course checkout).
# Blank = PUBLIC_URL (the web app is served from the same origin as the API).
PUBLIC_WEB_URL=
# Parent domain of institute website subdomains (<subdomain>.sites.example.com); optional. Only hosts
# directly under it resolve to a subdomain site; blank = verified custom domains only.
SITES_DOMAIN=sites.example.com
HTTP_PORT=80
HTTPS_PORT=443
# Origins allowed by CORS besides PUBLIC_URL (which is always first): the Capacitor apps.
CORS_EXTRA_ORIGINS=capacitor://localhost,https://localhost,http://localhost
# true: start nginx with a temporary self-signed certificate while deploy/certs/platform is missing
# (needed once for the first ACME HTTP-01 challenge). Set to false once real certificates are installed.
TLS_SELF_SIGNED_FALLBACK=true
# Content-Security-Policy of the web app: report-only (default) or enforce; optional report endpoint.
SPA_CSP_MODE=report-only
SPA_CSP_REPORT_URI=
# true: also accept biometric device pushes (/iclock/) over plain HTTP on HTTP_PORT, for devices without
# HTTPS firmware; each device must also allow it in the app. See docs/integrations/biometric.md.
ADMS_ALLOW_HTTP=false

# ------------------------------------------------------------------ database (MySQL 8.4 container)
DB_NAME=erp_coaching
# Application user (created on the first start); must not be root.
DB_USER=erp
# openssl rand -hex 24
DB_PASSWORD=

# ------------------------------------------------------------------ application secrets (required)
# openssl rand -base64 48
JWT_ACCESS_SECRET=
# Exactly 32 random bytes, base64: openssl rand -base64 32
# Encrypts stored integration secrets; keep a copy in your vault - data encrypted with a lost key is lost.
ENCRYPTION_KEY=
# Optional, only while rotating ENCRYPTION_KEY: the earlier keys, comma separated. Empty it once
# `secrets:reencrypt --dry-run` finds nothing left (docs/deployment.md, "Rotating the encryption key").
ENCRYPTION_PREVIOUS_KEYS=
# Signs short-lived file/media URLs: openssl rand -hex 32
FILE_URL_SECRET=
# Keys the stored OTP codes, the per-mobile OTP counters and the sign-in locks of unregistered numbers:
# openssl rand -hex 32. Changing it invalidates the codes already sent.
OTP_HASH_SECRET=

# ------------------------------------------------------------------ application settings
LOG_LEVEL=info
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
IMPERSONATION_TTL_SECONDS=1800
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# OTP requests per mobile number per 10 minutes, whether or not the number has an account.
OTP_REQUESTS_PER_MOBILE=5
MAX_ACTIVE_DEVICES=2
# Sign-in lock: after LOGIN_LOCKOUT_THRESHOLD failed password, OTP or device-unlock attempts (0 = never lock),
# sign-in is locked for LOGIN_LOCKOUT_BASE_SECONDS, doubling with each further failure up to the maximum.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=900
# scrypt cost of new password hashes, as log2(N): 15 to 18. Each step doubles the time and memory (32 MiB at 15);
# sign-in rehashes passwords stored with another cost.
PASSWORD_HASH_COST=15
# Threads that hash passwords (and read files): about this many sign-ins run at once per api process.
UV_THREADPOOL_SIZE=4
# Upload limit; nginx allows MAX_UPLOAD_MB + 10 MB per request.
MAX_UPLOAD_MB=100
SIGNED_URL_TTL_SECONDS=300

# Error tracking: none | log (structured "error_tracking" log entries) | webhook (POST JSON events)
ERROR_TRACKING_PROVIDER=none
ERROR_TRACKING_WEBHOOK_URL=

# Rate limits per client IP (the api trusts one proxy hop: TRUST_PROXY=1 is set by the compose file),
# except RATE_LIMIT_MEDIA_PER_TOKEN_PER_MIN, which caps each signed media URL.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_MEDIA_PER_MIN=3000
RATE_LIMIT_MEDIA_PER_TOKEN_PER_MIN=300
RATE_LIMIT_WEBSITE_PER_MIN=300
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_TOKEN_MAX=600
RATE_LIMIT_PUBLIC_FORM_MAX=60
RATE_LIMIT_DEVICE_PER_MIN=120
RATE_LIMIT_WEBHOOK_PER_MIN=300

# Rate-limit counters and live-class rooms. Blank = the stack's redis service (redis://redis:6379).
# Another Redis: rediss://:<password>@host:6379 - every api process must use the same one.
REDIS_URL=

# Background jobs run inside the api container.
JOBS_WORKER_ENABLED=true
JOBS_POLL_INTERVAL_MS=2000
# Minutes between checks of open payment gateway orders and refunds (docs/integrations/payments.md).
PAYMENT_RECONCILE_INTERVAL_MINUTES=10

# AI defaults (the Super Admin can override them in the app).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=60000

# Integration adapters: only console/mock implementations exist in this release.
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=console
PUSH_PROVIDER=console
PAYMENT_GATEWAY=mock
STREAMING_PROVIDER=mock
BIOMETRIC_PROVIDER=mock
# Largest biometric device push in KB (up to 1024); bigger bodies get 413 before they are parsed.
BIOMETRIC_PUSH_MAX_KB=256

# Messaging vendors (MSG91, Twilio, WhatsApp Cloud, SMTP, FCM/APNs) are configured in the app:
# docs/integrations/messaging.md. Vendor request timeout, and the country code added to 10-digit mobiles.
MESSAGING_TIMEOUT_MS=15000
MESSAGING_DEFAULT_COUNTRY_CODE=91

# ------------------------------------------------------------------ live classes: LiveKit (optional)
# STREAMING_PROVIDER=livekit replaces the peer-to-peer WebRTC transport (docs/integrations/live-streaming.md).
# Self-hosted (docker compose --profile livekit up -d): LIVEKIT_URL=wss://<SERVER_NAME>/livekit and
# LIVEKIT_API_URL=http://host.docker.internal:7880. LiveKit Cloud: the project's wss:// URL, LIVEKIT_API_URL
# blank, LIVEKIT_RECORDING_OUTPUT=s3 and a staging bucket. Generate the key pair (letters and digits, the
# secret at least 32 characters) with: docker run --rm livekit/livekit-server:v1.13.11 generate-keys
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM_PREFIX=erp
LIVEKIT_RECORDING_OUTPUT=local
LIVEKIT_S3_BUCKET=
LIVEKIT_S3_REGION=us-east-1
LIVEKIT_S3_ENDPOINT=
LIVEKIT_S3_ACCESS_KEY=
LIVEKIT_S3_SECRET_KEY=
LIVEKIT_S3_FORCE_PATH_STYLE=false
# Profile livekit: TURN over TLS on this port with the platform certificate; 0 = TURN over UDP only.
LIVEKIT_TURN_TLS_PORT=5349
# Each participant join and leave is one webhook from LiveKit's address: for large or simultaneous classes,
# raise RATE_LIMIT_WEBHOOK_PER_MIN and RATE_LIMIT_API_PER_MIN above (docs/integrations/live-streaming.md).

# ZKTeco/eSSL biometric devices (ADMS push on /iclock/*): requests per minute per client IP, largest
# upload in KB (at most 8192), most records per upload, and how many days back punches are recorded.
RATE_LIMIT_ADMS_PER_MIN=600
ADMS_MAX_BODY_KB=2048
ADMS_MAX_RECORDS=10000
ADMS_BACKFILL_DAYS=31

# ------------------------------------------------------------------ first deploy: super admin seeding
# `docker compose run --rm migrate node dist/infrastructure/database/cli.js seed` creates this user once
# (an existing user's password is never changed). Production refuses a password shorter than 12
# characters or the development default. Remove the password from this file after seeding.
SEED_SUPERADMIN_MOBILE=
SEED_SUPERADMIN_PASSWORD=
SEED_DEMO_DATA=false

# ------------------------------------------------------------------ backups (docker compose --profile ops run --rm backup)
BACKUP_HOST_DIR=./backups
BACKUP_KEEP_COUNT=14
BACKUP_KEEP_DAYS=30
# Owner of the backup files on the host (default root).
BACKUP_UID=0
BACKUP_GID=0
