# Proxy settings shared by every location that forwards to the API (rendered to
# /etc/nginx/erp/snippets/proxy-headers.conf). With TRUST_PROXY=1 the API takes the client address from
# the last X-Forwarded-For entry (the one appended here) and the scheme/host from X-Forwarded-Proto/Host.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Request-Id $erp_request_id;
# WebSocket upgrades when requested; otherwise an empty Connection header keeps upstream keepalive.
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
